# ============================================================
#  FinTrack — Root .gitignore
#  Git repo root: E:/Serverless Expense and Wallet Tracker/
# ============================================================

# ── Node / npm ───────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Build output ─────────────────────────────────────────────
dist/
dist-ssr/
build/

# ── Environment / secrets — NEVER commit these ───────────────
.env
.env.*
!.env.example

# ── Vite ─────────────────────────────────────────────────────
.vite/
*.local

# ── OS artifacts ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor / IDE ─────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log

# ── Test / coverage ──────────────────────────────────────────
coverage/
*.tsbuildinfo

# ── Spec / planning docs (frontend) ──────────────────────────
frontend/frontend_architecture_design.md
frontend/frontend_implementation_plan.md
frontend/frontend_requirements_specification.md
frontend/frontend_task_execution_list.md